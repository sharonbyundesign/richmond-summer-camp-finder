# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only key for privileged writes (e.g. the launch-waitlist email_signups
# table, which has RLS enabled and no policies). NEVER prefix this with
# NEXT_PUBLIC_ — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email (Resend), server-only. Parent check-ins stay hidden until both are set:
# a check-in counts only once its confirm link is clicked. EMAIL_FROM must be a
# sender on a domain verified in Resend, e.g. "Scouty <hello@your-domain.com>".
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Scouty <hello@your-domain.com>
